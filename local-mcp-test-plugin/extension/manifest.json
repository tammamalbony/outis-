{
  "manifest_version": 3,
  "name": "Local MCP Bridge",
  "version": "0.4.3",
  "description": "Send messages, JSON data, and events to and from the local MCP test server.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Local MCP Bridge",
    "default_popup": "popup.html"
  }
}
